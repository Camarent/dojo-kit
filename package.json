{
  "name": "dojo-kit",
  "version": "0.1.7",
  "description": "Generic exam-trainer framework: build offline study apps from course content.",
  "license": "MIT",
  "author": "Camarent",
  "homepage": "https://github.com/Camarent/dojo-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Camarent/dojo-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Camarent/dojo-kit/issues"
  },
  "keywords": [
    "exam",
    "trainer",
    "spaced-repetition",
    "quiz",
    "wasm",
    "offline"
  ],
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "bash scripts/check-all.sh",
    "lint": "eslint .",
    "audit:js": "knip --no-config-hints && madge --circular --extensions js web && jscpd web --min-lines 10 --min-tokens 70 --threshold 5 --ignore \"**/vendor/**,**/tests/**\" --silent && npm audit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.14.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "madge": "8.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
