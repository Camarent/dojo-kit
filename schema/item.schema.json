  "$defs": {
    "Status": {
      "description": "Lifecycle state of an item; a retired id may leave the content if listed in ids.lock `retired` (see CONTRACT.md:64) and is skipped by queues.",
      "type": "string",
      "enum": [
        "active",
        "retired"
      ]
    },
    "Normalize": {
      "description": "How typed answers are compared. Defaults: trim and collapse spaces, case-insensitive, keep punctuation.",
      "type": "object",
      "properties": {
        "caseSensitive": {
          "type": "boolean",
          "default": false
        },
        "trim": {
          "type": "boolean",
          "default": true
        },
        "collapseSpaces": {
          "type": "boolean",
          "default": true
        },
        "stripPunctuation": {
          "type": "boolean",
          "default": false
        },
        "fold": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "InputMode": {
      "description": "Soft-keyboard hint for a gap input; display only, never graded.",
      "type": "string",
      "enum": [
        "numeric",
        "decimal",
        "text"
      ]
    },
    "Pair": {
      "description": "One left/right pair of a `match` item.",
      "type": "object",
      "properties": {
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ]
    },
    "ClozePart": {
      "description": "A cloze part: literal text, or a blank listing its accepted alternatives.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    }
  }
